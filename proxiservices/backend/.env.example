# Copier ce fichier en ".env" et renseigner de vraies valeurs. Ne jamais committer le ".env".

# Base de données (compatible Supabase / Neon / PostgreSQL classique)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/proxiservices

# Sécurité JWT — générer une valeur aléatoire longue (ex: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Paydunia
PAYDUNIA_API_KEY=
PAYDUNIA_WEBHOOK_SECRET=change-me

# Règles métier (voir cahier des charges)
COMMISSION_RATE=0.08
PRO_SUBSCRIPTION_PRICE_FCFA=2000
BOOST_PRICE_FCFA=500

# CORS — liste JSON des origines autorisées (ex: le frontend statique)
CORS_ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

ENVIRONMENT=development
